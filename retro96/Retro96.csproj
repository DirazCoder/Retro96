<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Retro96</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RootNamespace>Retro96</RootNamespace>
    <Deterministic>true</Deterministic>
    <WarningLevel>5</WarningLevel>
    <!-- Allows building the -windows TFM from non-Windows hosts; no effect when built on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- ========================================== -->
    <!-- FORCE BYPASS THE HARD WINFORMS TRIM GUARD  -->
    <!-- ========================================== -->
    <!-- The exact property needed to suppress error NETSDK1175 -->
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    <NoWarn>$(NoWarn);IL2104;IL2026;IL3000;IL3002;IL3050;IL3053;NETSDK1175;NETSDK1057</NoWarn>

    <!-- ========================================== -->
    <!-- MAXIMUM HIGH-PERFORMANCE ENGINE TUNING     -->
    <!-- ========================================== -->
    <Configuration>Release</Configuration>
    <!-- PublishAot implies SelfContained + a RID; without an explicit RID the SDK falls
         back to the host RID (linux-x64) and the WinForms runtime pack does not exist
         for it (NETSDK1082). AOT publishes are Windows-only, so default the RID to
         win-x64; plain non-AOT builds on any OS stay RID-less. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(PublishAot)' == 'true' and '$(SelfContained)' != 'false'">win-x64</RuntimeIdentifier>
    <PublishAot>false</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>

    <!-- Partial trimming maintains critical WinForms drawing plumbing -->
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Transitional compatibility: the broker protocol still serializes a broader
         set of runtime payload types with reflection. Plugin manifests use the
         source-generated context below; keep reflection enabled until the whole
         broker protocol is converted to source generation. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

    <!-- ========================================== -->
    <!-- CLOSED SOURCE & HARDENED AOT CONFIG        -->
    <!-- ========================================== -->
    <!-- 1. Kill all PDB generation and debug directories -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>

    <!-- 2. Strip Stack Trace information (Removes method names/strings from the binary) -->
    <StackTraceSupport>false</StackTraceSupport>

    <!-- 3. Instruct the native linker to strip symbols completely -->
    <StripSymbols>true</StripSymbols>

    <!-- 4. Erase local machine paths from the compiled binary -->
    <PathMap>\$(MSBuildProjectDirectory)=/_/</PathMap>

    <!-- 5. Remove exception messages (replaces them with generic system messages) -->
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!-- 6. Optimize the native compiler to drop all non-essential reflection data -->
    <IlcGenerateMetadataFromFullTypeHierarchy>false</IlcGenerateMetadataFromFullTypeHierarchy>
    <IlcTrimMetadata>true</IlcTrimMetadata>
  </PropertyGroup>

  <!-- SkiaSharp is the engine's rendering, 
       text-measurement and image-decoding stack. -->
  <ItemGroup>
    <!-- The WinForms SDK injects a GLOBAL `using System.Drawing;` which 
         would make every engine type (Color/Font/Bitmap/Graphics…) in 
         Retro96.Drawing ambiguous inside this project. Drop the global 
         import: engine files carry their own `using Retro96.Drawing;`, 
         and shell files import System.Drawing explicitly where needed. -->
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- The public plugin contract is compiled directly into the Retro96 host.
       The standalone Retro96 Plugin SDK repository contains the same source contract
       for plugin authors, but the host build never restores, builds, or requires the SDK.
       Keeping the contract in the host also means the sandbox worker can hand the host
       assembly to PluginAssemblyLoadContext for the shared API type identity. -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="4.153.1" />
  </ItemGroup>

  <!-- ========================================== -->
  <!-- SECURE EMBEDDED ASSETS                     -->
  <!-- ========================================== -->
  <!-- This compiles the files inside your single-file exe instead of copying them -->
  <ItemGroup>
    <EmbeddedResource Include="assets\**\*" />
  </ItemGroup>

</Project>
